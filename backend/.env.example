# ============================================================
# Smart Academic Advisor — Backend Environment Configuration
# ============================================================
# Usage:
#   1. Copy this file:   cp .env.example .env
#   2. Fill in real values (especially AI_API_KEY).
#   3. NEVER commit `.env` to git. Only `.env.example` lives in the repo.
# ============================================================

# ────────────────────────────────────────────────────────────
# Server
# ────────────────────────────────────────────────────────────
# Bind address.
#   • Containers / PaaS (Render, Railway, Fly, Docker): 0.0.0.0
#   • Local development only:                           127.0.0.1
HOST=0.0.0.0
PORT=8000

# Flask debug mode. MUST be false in production.
# Enabling it exposes the Werkzeug debugger (remote code execution risk).
DEBUG=false

# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ────────────────────────────────────────────────────────────
# AI Provider (OpenAI-compatible API)
# ────────────────────────────────────────────────────────────
# REQUIRED for live AI advice. Leave empty to force offline-advice mode.
# The backend should fail fast with a clear message if a live request is
# attempted while this is empty.
AI_API_KEY=

# Base URL of the OpenAI-compatible endpoint (no trailing slash).
# Examples:
#   DeepSeek : https://api.deepseek.com
#   OpenAI   : https://api.openai.com/v1
#   Ollama   : http://localhost:11434/v1
AI_BASE_URL=https://api.deepseek.com

# Chat model name.
AI_MODEL=deepseek-chat

# Upstream request timeout in seconds. Prevents hung connections.
AI_TIMEOUT_SECONDS=30

# Max retries on transient upstream failures (5xx / timeout).
# Keep small: each retry costs latency and tokens.
AI_MAX_RETRIES=1

# ────────────────────────────────────────────────────────────
# Request Validation
# ────────────────────────────────────────────────────────────
# Maximum user question length (characters).
MAX_QUESTION_LENGTH=1500

# Maximum HTTP request body size (bytes). Rejects oversized payloads early.
MAX_BODY_BYTES=16384

# ────────────────────────────────────────────────────────────
# Rate Limiting
# ────────────────────────────────────────────────────────────
# Per-IP limits.
# ⚠️  The default in-memory store is PER-PROCESS. With multiple
#     workers/replicas the effective limits multiply by worker count.
#     For production, set RATE_LIMIT_STORAGE=redis.
MAX_REQUESTS_PER_MINUTE=10
MAX_REQUESTS_PER_DAY=50

# Maximum response size accepted from the AI provider (bytes).
MAX_UPSTREAM_RESPONSE_BYTES=1048576

# Storage backend for rate limiting: "memory" (default) or "redis".
RATE_LIMIT_STORAGE=memory

# Required only when RATE_LIMIT_STORAGE=redis.
# REDIS_URL=redis://localhost:6379/0

# ────────────────────────────────────────────────────────────
# CORS (only needed if the API is called from a browser / Flutter Web)
# ────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
#   • Dev:   ALLOWED_ORIGINS=
#   • Prod:  ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
# NEVER use "*" in production together with credentialed requests.
ALLOWED_ORIGINS=*
